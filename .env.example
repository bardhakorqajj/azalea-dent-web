# ---------------------------------------------------------------------------
# Copy to `.env.local` for development, and set the same keys in your hosting
# provider for production. Never commit `.env.local` — it is git-ignored.
# ---------------------------------------------------------------------------

# Canonical origin, used for metadata, hreflang, sitemap.xml and robots.txt.
# Set this to the live domain once it is connected, e.g. https://azalea-dent.org
# On Vercel it falls back to the project's production URL automatically.
#
# Read on the server only, so it has no NEXT_PUBLIC_ prefix. The old
# NEXT_PUBLIC_SITE_URL name still works if it is already set somewhere.
SITE_URL=

# ---------------------------------------------------------------------------
# Appointment requests
#
# Every channel configured below is used, so a request can arrive by email and
# by text at the same time. With none of them set, /api/appointment answers 501
# and the form tells the patient plainly that nothing was sent, offering
# WhatsApp, Viber and Instagram instead.
# ---------------------------------------------------------------------------

# --- Email, via Resend (https://resend.com — the free tier is enough) -------
# The only required value. Requests go to the clinic address in
# src/content/clinic.ts (azaleadent@hotmail.com) unless overridden below.
#
# Sign up for Resend with azaleadent@hotmail.com. Until a domain is verified,
# Resend delivers only to the address that owns the Resend account, so the
# account owner and the recipient have to be the same mailbox.
RESEND_API_KEY=

# Optional. Overrides the recipient.
APPOINTMENT_TO_EMAIL=

# Optional. The sender address, which must be on a domain verified in Resend.
# Defaults to "Azalea Dent <onboarding@resend.dev>", which only delivers to the
# Resend account owner and is for testing only. Once azalea-dent.org is
# verified in Resend, set this to e.g. "Azalea Dent <takime@azalea-dent.org>".
APPOINTMENT_FROM_EMAIL=

# --- Text message, via Twilio (https://twilio.com — pay per message) -------
# All three are required to send a text. It goes to the clinic's first
# published number (+383 48 306 376) unless overridden below.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional. Overrides the number that receives the text.
APPOINTMENT_SMS_TO=

# --- Or POST the request as JSON anywhere -----------------------------------
# Zapier, Make, n8n, a Google Sheet webhook, a clinic CRM.
APPOINTMENT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Admin dashboard
#
# The dashboard is the same application as the website, served on its own
# hostname. Without DATABASE_URL there is no dashboard at all: the login page
# says so, and the website carries on serving the content it ships with.
# ---------------------------------------------------------------------------

# PostgreSQL 16 or newer. Required for the dashboard.
#
# Any managed Postgres works — Neon, Supabase, Vercel Postgres, a VPS. On
# Vercel the integration sets POSTGRES_URL, which is read as a fallback, so
# this can be left empty there.
#
# TLS is on for every host except localhost. The certificate is not verified
# by default, because managed providers commonly present one that a bare Node
# client cannot chain; set PGSSL_STRICT=1 to require a verifiable chain, or
# PGSSLMODE=disable to turn TLS off (only ever on a private network).
#
# Run `npm run db:migrate` once after setting this, and `npm run db:status` to
# see what has been applied.
DATABASE_URL=

# Optional. Connections in the pool, per server instance. Default 5, which
# suits a serverless host where many short-lived instances each hold a pool.
DATABASE_POOL_MAX=

# The hostname that serves the dashboard. Everything else 404s there, and the
# dashboard 404s everywhere else — there is no /admin URL on the website.
#
# Defaults to `admin.` in front of the host in SITE_URL, so it can be left
# empty in production. Set it in development to test the real split:
#
#   ADMIN_HOST=admin.localhost:3000
#
# (`admin.localhost` resolves on most systems; add it to /etc/hosts if not.)
ADMIN_HOST=

# ---------------------------------------------------------------------------
# The single admin account
#
# There is one, for the clinic. There is no registration, no invitations and
# no second role — see README.md.
#
# The normal way to create it is `npm run admin:setup`, which asks for the
# email and password at the terminal and writes the account to the database.
# The password is never a command-line flag, so it stays out of your shell
# history and out of the process list.
#
# The two variables below are the other way in: for a host whose database is
# not reachable from your machine. Run `npm run admin:setup -- --hash`, paste
# the values it prints into the host's environment, and the account is created
# from them the first time you sign in. The hash is safe to store this way —
# it is not the password, and the password cannot be read back out of it.
# ---------------------------------------------------------------------------

ADMIN_EMAIL=

# A scrypt hash, in the form `scrypt$N$r$p$salt$hash`. Never a password.
ADMIN_PASSWORD_HASH=

# Escape hatch for development only: serves the session cookie without the
# Secure flag, which a browser will not send back over plain http. Never set
# this in production — it is what would let a session cookie travel in clear.
# ADMIN_COOKIE_INSECURE=1
